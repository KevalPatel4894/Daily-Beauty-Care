<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/toolBarColor">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/txtTabTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/face_shape_guide_title"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_18sdp" />
    </androidx.appcompat.widget.Toolbar>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/ad_view"
        android:layout_below="@+id/toolBar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_12sdp">

            <!-- Question 1: Widest part -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/q_widest_part"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgWidestPart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp">

                <RadioButton
                    android:id="@+id/rbCheekbones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/opt_widest_cheekbones"
                    android:textColor="#222222"
                    android:textSize="12sp"
                    app:buttonTint="@color/radio_button_tint"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rbForehead"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/opt_widest_forehead"
                    android:textColor="#222222"
                    android:textSize="12sp"
                    app:buttonTint="@color/radio_button_tint" />

                <RadioButton
                    android:id="@+id/rbJaw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/opt_widest_jaw"
                    android:textColor="#222222"
                    android:textSize="12sp"
                    app:buttonTint="@color/radio_button_tint" />

                <RadioButton
                    android:id="@+id/rbEqualWidth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/opt_widest_equal"
                    android:textColor="#222222"
                    android:textSize="12sp"
                    app:buttonTint="@color/radio_button_tint" />
            </RadioGroup>

            <!-- Question 2: Jaw shape -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/q_jaw_shape"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgJawShape"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp">

                <RadioButton
                    android:id="@+id/rbJawRound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/opt_jaw_round"
                    android:textColor="#222222"
                    android:textSize="12sp"
                    app:buttonTint="@color/radio_button_tint"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rbJawSquare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/opt_jaw_square"
                    android:textColor="#222222"
                    android:textSize="12sp"
                    app:buttonTint="@color/radio_button_tint" />

                <RadioButton
                    android:id="@+id/rbJawPointed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/opt_jaw_pointed"
                    android:textColor="#222222"
                    android:textSize="12sp"
                    app:buttonTint="@color/radio_button_tint" />
            </RadioGroup>

            <!-- Question 3: Face length -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/q_face_length"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgFaceLength"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp">

                <RadioButton
                    android:id="@+id/rbLengthLonger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/opt_length_longer"
                    android:textColor="#222222"
                    android:textSize="12sp"
                    app:buttonTint="@color/radio_button_tint"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rbLengthEqual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/opt_length_equal"
                    android:textColor="#555555"
                    android:textSize="12sp"
                    app:buttonTint="@color/radio_button_tint" />
            </RadioGroup>

            <!-- Calculate Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalculateFaceShape"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_calculate_face_shape"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/toolBarColor"
                app:cornerRadius="10dp" />

            <!-- Result Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFaceResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FAF0F6"
                app:strokeColor="#F48FB1"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_14sdp">

                    <TextView
                        android:id="@+id/txtResultTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/toolBarColor"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="👤 Oval Face Shape" />

                    <TextView
                        android:id="@+id/txtResultDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#555555"
                        android:textSize="12sp"
                        tools:text="Slightly longer than wide with balanced proportions." />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="#E0E0E0" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🎨 Contouring Technique:"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtResultContour"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#555555"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="👁️ Eyebrow Shaping:"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtResultBrows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#555555"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="💇 Best Hairstyle Recommendations:"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtResultHair"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#555555"
                        android:textSize="12sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <RelativeLayout
        android:id="@+id/ad_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:gravity="center" />

</RelativeLayout>
